def generate_fallback_recommendations(member_id):
    conn = get_db_connection()
    c = conn.cursor()

    c.execute("""
        SELECT DISTINCT b.id, b.title, b.category, b.author
        FROM issued_books i
        JOIN books b ON i.book_id = b.id
        WHERE i.member_id = ?
    """, (member_id,))
    history = c.fetchall()

    borrowed_book_ids = {row['id'] for row in history}
    preferred_categories = {}
    preferred_authors = {}
    
    for row in history:
        category = row['category']
        author = row['author']
        if category:
            preferred_categories[category] = preferred_categories.get(category, 0) + 1
        if author:
            preferred_authors[author] = preferred_authors.get(author, 0) + 1

    c.execute("""
        SELECT id, title, author, category
        FROM books
        WHERE status = 'available'
        ORDER BY title
    """)
    available_books = c.fetchall()
    conn.close()

    if not available_books:
        return jsonify([])

    book_scores = []
    for book in available_books:
        book_dict = dict(book)
        
        if book_dict['id'] in borrowed_book_ids:
            continue
        
        score = 0
        reasons = []

        if book_dict['category'] in preferred_categories:
            score += preferred_categories[book_dict['category']] * 3
            reasons.append(f"You've enjoyed {preferred_categories[book_dict['category']]} book(s) in {book_dict['category']}")

        if book_dict['author'] in preferred_authors:
            score += preferred_authors[book_dict['author']] * 2
            reasons.append(f"You've read other books by {book_dict['author']}")

        import random
        score += random.uniform(0, 0.5)

        if not reasons and preferred_categories:
            top_category = max(preferred_categories, key=preferred_categories.get)
            reasons.append(f"This {book_dict['category'] or 'book'} offers a fresh perspective from your usual {top_category} reads")
        elif not reasons:
            reasons.append("Popular choice in our library")

        book_scores.append({
            'book': book_dict,
            'score': score,
            'reason': reasons[0] if reasons else "Recommended based on library popularity"
        })

    book_scores.sort(key=lambda x: x['score'], reverse=True)
    top_recommendations = book_scores[:5]

    recommendations = []
    for item in top_recommendations:
        book = item['book']
        recommendations.append({
            'book_id': book['id'],
            'title': book['title'],
            'author': book['author'],
            'category': book['category'] or 'Uncategorized',
            'reason': item['reason']
        })

    return jsonify(recommendations)

@app.route('/get_recommended_books/<int:member_id>')
def get_recommended_books(member_id):
    conn = get_db_connection()
    c = conn.cursor()

    c.execute("SELECT id, title, author, category FROM books WHERE status='available'")
    books = c.fetchall()

    c.execute("""
        SELECT DISTINCT b.category
        FROM issued_books i
        JOIN books b ON i.book_id = b.id
        WHERE i.member_id = ? AND b.category IS NOT NULL
    """, (member_id,))
    preferred_categories = {row['category'] for row in c.fetchall()}

    conn.close()

    all_books = [dict(row) for row in books]
    
    for book in all_books:
        book['recommended'] = book.get('category') in preferred_categories
        book['is_issued'] = False

    all_books.sort(key=lambda x: (not x['recommended'], x['title'].lower()))

    return jsonify(all_books)

