@app.route('/issue_book', methods=['POST'])
@admin_required
def issue_book():
    data = request.get_json()
    book_id = data.get('book_id')
    member_id = data.get('member_id')

    issue_date = datetime.now().strftime('%Y-%m-%d')
    due_date = (datetime.now() + timedelta(days=30)).strftime('%Y-%m-%d')

    conn = get_db_connection()
    c = conn.cursor()

    c.execute("SELECT status FROM books WHERE id = ?", (book_id,))
    book = c.fetchone()
    if not book or book['status'] != 'available':
        conn.close()
        return jsonify({'message': 'Book not available', 'recommendations': []}), 400

    c.execute("""
        INSERT INTO issued_books (book_id, member_id, issue_date, due_date)
        VALUES (?, ?, ?, ?)
    """, (book_id, member_id, issue_date, due_date))
    c.execute("UPDATE books SET status = 'borrowed' WHERE id = ?", (book_id,))
    conn.commit()

    c.execute("SELECT category FROM books WHERE id = ?", (book_id,))
    current_book = c.fetchone()

    recommendations = []
    if current_book and current_book['category']:
        category = current_book['category']
        c.execute("""
            SELECT id, title, author, category
            FROM books
            WHERE id != ? AND category = ? AND status = 'available'
            LIMIT 3
        """, (book_id, category))
        rec_books = c.fetchall()
        recommendations = [dict(b) for b in rec_books]

    conn.close()
    print("AI Recommendations for this issue:", recommendations)

    return jsonify({
        'message': f'Book issued successfully! Due on {due_date}.',
        'recommendations': recommendations
    }), 200

@app.route('/return_book', methods=['POST'])
@admin_required
def return_book():
    data = request.get_json()
    issue_id = data.get('issue_id')

    conn = get_db_connection()
    c = conn.cursor()

    return_date = datetime.now().strftime('%Y-%m-%d')

    c.execute("SELECT book_id FROM issued_books WHERE id = ?", (issue_id,))
    row = c.fetchone()
    if not row:
        conn.close()
        return jsonify({'message': 'Issue record not found'}), 404

    book_id = row['book_id']

    c.execute("""
        UPDATE issued_books
        SET return_date = ?
        WHERE id = ?
    """, (return_date, issue_id))

    c.execute("UPDATE books SET status = 'available' WHERE id = ?", (book_id,))

    conn.commit()
    conn.close()

    return jsonify({'message': f'Book returned successfully on {return_date}.'}), 200


@app.route('/get_issue_history', methods=['GET'])
@admin_required
def get_issue_history():
    member_id = request.args.get('member_id')
    book_id = request.args.get('book_id')
    only_unreturned = request.args.get('only_unreturned') == '1'

    conn = sqlite3.connect('library.db')
    cur = conn.cursor()
    q = '''SELECT ib.id, ib.book_id, b.title, ib.member_id, m.name, ib.issue_date, ib.due_date, ib.return_date
           FROM issued_books ib
           LEFT JOIN books b ON ib.book_id = b.id
           LEFT JOIN members m ON ib.member_id = m.id
           WHERE 1=1'''
    params = []
    if member_id:
        q += " AND ib.member_id=?"; params.append(member_id)
    if book_id:
        q += " AND ib.book_id=?"; params.append(book_id)
    if only_unreturned:
        q += " AND ib.return_date IS NULL"
    q += " ORDER BY ib.id DESC"
    cur.execute(q, params)
    rows = cur.fetchall()
    data = []
    for r in rows:
        fine = calculate_fine(r[6], r[7]) if r[6] else 0
        data.append({
            "issue_id": r[0],
            "book_id": r[1],
            "title": r[2],
            "member_id": r[3],
            "member_name": r[4],
            "issue_date": r[5],
            "due_date": r[6],
            "return_date": r[7],
            "fine": fine
        })
    conn.close()
    return jsonify(data)

@app.route('/export_issue_history', methods=['GET'])
@admin_required
def export_issue_history():
    member_id = request.args.get('member_id')
    book_id = request.args.get('book_id')
    only_unreturned = request.args.get('only_unreturned') == '1'

    conn = sqlite3.connect('library.db')
    cur = conn.cursor()
    q = '''SELECT ib.id, b.title, m.name, ib.issue_date, ib.due_date, ib.return_date
           FROM issued_books ib
           LEFT JOIN books b ON ib.book_id = b.id
           LEFT JOIN members m ON ib.member_id = m.id
           WHERE 1=1'''
    params = []
    if member_id:
        q += " AND ib.member_id=?"; params.append(member_id)
    if book_id:
        q += " AND ib.book_id=?"; params.append(book_id)
    if only_unreturned:
        q += " AND ib.return_date IS NULL"
    q += " ORDER BY ib.id DESC"
    cur.execute(q, params)
    rows = cur.fetchall()
    conn.close()

    output = io.StringIO()
    writer = csv.writer(output)
    writer.writerow(["issue_id", "book_title", "member_name", "issue_date", "due_date", "return_date", "fine"])
    for r in rows:
        fine = calculate_fine(r[4], r[5]) if r[4] else 0
        writer.writerow([r[0], r[1], r[2], r[3], r[4], r[5], fine])
    output.seek(0)
    return send_file(io.BytesIO(output.getvalue().encode('utf-8')),
                     mimetype='text/csv', download_name='issue_history.csv', as_attachment=True)

