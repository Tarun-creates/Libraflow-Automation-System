@app.route('/')
def home():
    return render_template('index.html')

# Check admin status
@app.route('/check_admin', methods=['GET'])
def check_admin():
    return jsonify({"is_admin": 'admin' in session})

# ----- PUBLIC ROUTES (No Auth Required) -----
@app.route('/get_statistics', methods=['GET'])
def get_statistics():
    try:
        conn = sqlite3.connect('library.db')
        cur = conn.cursor()
        
        cur.execute("SELECT COUNT(*) FROM books")
        total_books = cur.fetchone()[0]

        cur.execute("SELECT COUNT(*) FROM books WHERE status='available'")
        available_books = cur.fetchone()[0]

        cur.execute("SELECT COUNT(*) FROM books WHERE status='borrowed'")
        borrowed_books = cur.fetchone()[0]

        cur.execute("SELECT COUNT(*) FROM members")
        total_members = cur.fetchone()[0]

        conn.close()

        return jsonify({
            "total_books": total_books,
            "available_books": available_books,
            "borrowed_books": borrowed_books,
            "total_members": total_members
        })
    except Exception as e:
        print(f"Error in get_statistics: {e}")
        return jsonify({"error": str(e)}), 500

@app.route('/get_books_paginated', methods=['GET'])
def get_books_paginated():
    filter_type = request.args.get('filter', 'all')
    search = request.args.get('search', '').strip().lower()
    page = int(request.args.get('page', 1))
    per_page = int(request.args.get('per_page', 10))
    sort_by = request.args.get('sort', 'title')
    sort_order = request.args.get('order', 'asc')

    offset = (page - 1) * per_page

    conn = sqlite3.connect('library.db')
    cur = conn.cursor()

    query = "SELECT * FROM books WHERE 1=1"
    params = []

    if filter_type == 'available':
        query += " AND status='available'"
    elif filter_type == 'borrowed':
        query += " AND status='borrowed'"

    if search:
        query += " AND (LOWER(title) LIKE ? OR LOWER(author) LIKE ? OR LOWER(category) LIKE ?)"
        params.extend([f"%{search}%"] * 3)

    cur.execute(query, params)
    total = len(cur.fetchall())

    if sort_by not in ['title', 'author', 'category', 'status', 'id']:
        sort_by = 'title'
    order_clause = 'ASC' if sort_order.lower() == 'asc' else 'DESC'
    query += f" ORDER BY {sort_by} {order_clause}"

    query += " LIMIT ? OFFSET ?"
    params.extend([per_page, offset])

    cur.execute(query, params)
    rows = cur.fetchall()
    conn.close()

    books = [{"id": r[0], "title": r[1], "author": r[2], "category": r[3], "status": r[4]} for r in rows]
    return jsonify({"books": books, "total": total, "page": page, "per_page": per_page})

@app.route('/get_book_details/<int:book_id>', methods=['GET'])
def get_book_details(book_id):
    conn = sqlite3.connect('library.db')
    cur = conn.cursor()
    cur.execute("SELECT * FROM books WHERE id=?", (book_id,))
    book = cur.fetchone()
    if not book:
        conn.close()
        return jsonify({"error": "Book not found"}), 404

    cur.execute("""
        SELECT ib.id, ib.member_id, m.name, ib.issue_date, ib.due_date, ib.return_date
        FROM issued_books ib LEFT JOIN members m ON ib.member_id = m.id
        WHERE ib.book_id=? ORDER BY ib.id DESC LIMIT 1
    """, (book_id,))
    issue = cur.fetchone()
    conn.close()

    issued_to = None
    issue_date = None
    return_date = None
    if issue and issue[5] is None:
        issued_to = issue[2]
        issue_date = issue[3]
        return_date = issue[5]

    return jsonify({
        "id": book[0],
        "title": book[1],
        "author": book[2],
        "category": book[3],
        "status": book[4],
        "issued_to": issued_to,
        "issue_date": issue_date,
        "return_date": return_date
    })

@app.route('/get_members_paginated', methods=['GET'])
def get_members_paginated():
    search = request.args.get('search', '').strip().lower()
    page = int(request.args.get('page', 1))
    per_page = int(request.args.get('per_page', 10))
    offset = (page - 1) * per_page

    conn = sqlite3.connect('library.db')
    cur = conn.cursor()

    query = "SELECT * FROM members WHERE 1=1"
    params = []
    if search:
        query += " AND LOWER(name) LIKE ?"
        params.append(f"%{search}%")

    cur.execute(query, params)
    total = len(cur.fetchall())

    query += " LIMIT ? OFFSET ?"
    params.extend([per_page, offset])
    cur.execute(query, params)
    rows = cur.fetchall()
    conn.close()

    members = [{"id": r[0], "name": r[1], "email": r[2], "phone": r[3]} for r in rows]
    return jsonify({"members": members, "total": total, "page": page, "per_page": per_page})

@app.route('/get_member/<int:member_id>', methods=['GET'])
def get_member(member_id):
    conn = sqlite3.connect('library.db')
    cur = conn.cursor()
    cur.execute("SELECT id, name, email, phone FROM members WHERE id=?", (member_id,))
    r = cur.fetchone()
    if not r:
        conn.close()
        return jsonify({"error": "Member not found"}), 404
    member = {"id": r[0], "name": r[1], "email": r[2], "phone": r[3]}

    cur.execute('''SELECT ib.id, ib.book_id, b.title, ib.issue_date, ib.due_date, ib.return_date
                   FROM issued_books ib LEFT JOIN books b ON ib.book_id = b.id
                   WHERE ib.member_id=? ORDER BY ib.id DESC''', (member_id,))
    rows = cur.fetchall()
    history = []
    for row in rows:
        fine = 0
        if row[4]:
            fine = calculate_fine(row[4], row[5])
        history.append({
            "issue_id": row[0],
            "book_id": row[1],
            "title": row[2],
            "issue_date": row[3],
            "due_date": row[4],
            "return_date": row[5],
            "fine": fine
        })
    conn.close()
    return jsonify({"member": member, "history": history})

@app.route('/stats_summary', methods=['GET'])
def stats_summary():
    try:
        conn = sqlite3.connect('library.db')
        cur = conn.cursor()
        
        cur.execute("SELECT COUNT(*) FROM books")
        total_books = cur.fetchone()[0] or 0
        
        cur.execute("SELECT COUNT(*) FROM books WHERE status='available'")
        available_books = cur.fetchone()[0] or 0
        
        cur.execute("SELECT COUNT(*) FROM books WHERE status='borrowed'")
        borrowed_books = cur.fetchone()[0] or 0
        
        cur.execute("SELECT COUNT(*) FROM members")
        total_members = cur.fetchone()[0] or 0
        
        cur.execute("SELECT COALESCE(category, 'Uncategorized') as cat, COUNT(*) as c FROM books GROUP BY category ORDER BY c DESC LIMIT 6")
        cats = cur.fetchall()
        conn.close()
        
        return jsonify({
            "total_books": total_books,
            "available_books": available_books,
            "borrowed_books": borrowed_books,
            "total_members": total_members,
            "top_categories": [{"category": r[0], "count": r[1]} for r in cats]
        })
    except Exception as e:
        print(f"Error in stats_summary: {e}")
        import traceback
        traceback.print_exc()
        return jsonify({"error": str(e)}), 500

@app.route('/get_issued_books')
def get_issued_books():
    conn = sqlite3.connect('library.db')
    cur = conn.cursor()

    cur.execute("""
        SELECT ib.id AS issue_id,
               b.title,
               m.name AS member_name
        FROM issued_books ib
        JOIN books b ON ib.book_id = b.id
        JOIN members m ON ib.member_id = m.id
        WHERE ib.return_date IS NULL
    """)

    rows = cur.fetchall()
    conn.close()

    issued_books = []
    for r in rows:
        issued_books.append({
            "issue_id": r[0],
            "title": r[1],
            "member_name": r[2]
        })

    return jsonify(issued_books)

# Replace the /get_recommended_books route in your Flask app with this:

@app.route('/get_recommended_books/<int:member_id>')
def get_recommended_books(member_id):
    conn = get_db_connection()
    c = conn.cursor()

    # Get all available books
    c.execute("SELECT id, title, author, category FROM books WHERE status='available'")
    books = c.fetchall()

    # Get member's borrowing history
    c.execute("""
        SELECT DISTINCT b.id, b.title, b.author, b.category
        FROM issued_books i
        JOIN books b ON i.book_id = b.id
        WHERE i.member_id = ?
    """, (member_id,))
    history_books = c.fetchall()

    conn.close()

    if not books:
        return jsonify([])

    all_books = [dict(row) for row in books]
    
    # If no history, mark no books as recommended
    if not history_books:
        for book in all_books:
            book['recommended'] = False
        return jsonify(all_books)

    # Calculate recommendations using TF-IDF
    history_texts = [f"{b['title']} {b['author']} {b['category']}" for b in history_books]
    book_texts = [f"{b['title']} {b['author']} {b['category']}" for b in all_books]

    vectorizer = TfidfVectorizer(stop_words='english')
    tfidf_matrix = vectorizer.fit_transform(book_texts)
    history_matrix = vectorizer.transform(history_texts)

    history_mean = np.asarray(history_matrix.mean(axis=0)).ravel()
    tfidf_array = np.asarray(tfidf_matrix.todense())

    similarity = cosine_similarity([history_mean], tfidf_array).flatten()

    # Get top 5 recommendations
    top_indices = similarity.argsort()[-5:][::-1]
    recommended_ids = {all_books[i]['id'] for i in top_indices}

    # Mark recommended books
    for book in all_books:
        book['recommended'] = book['id'] in recommended_ids

    # Sort: recommended books first, then alphabetically by title
    all_books.sort(key=lambda x: (not x['recommended'], x['title'].lower()))

    return jsonify(all_books)

# ----- ADMIN PROTECTED ROUTES -----
@app.route('/add_book', methods=['POST'])
@admin_required
def add_book():
    data = request.get_json()
    title = data.get('title', '').strip()
    author = data.get('author', '').strip()
    category = data.get('category', '').strip()
    if not title or not author:
        return jsonify({"message": "title and author required"}), 400
    
    try:
        conn = sqlite3.connect('library.db')
        cur = conn.cursor()
        cur.execute("INSERT INTO books (title, author, category) VALUES (?, ?, ?)", (title, author, category))
        conn.commit()
        conn.close()
        return jsonify({"message": "Book added!", "success": True})
    except Exception as e:
        print(f"Error adding book: {e}")
        return jsonify({"message": "Failed to add book", "success": False}), 500

@app.route('/update_book', methods=['POST'])
@admin_required
def update_book():
    data = request.get_json()
    id_ = data.get('id')
    title = data.get('title')
    author = data.get('author')
    category = data.get('category')
    status = data.get('status')
    conn = sqlite3.connect('library.db')
    cur = conn.cursor()
    cur.execute("UPDATE books SET title=?, author=?, category=?, status=? WHERE id=?", (title, author, category, status, id_))
    conn.commit()
    conn.close()
    return jsonify({"message": "Book updated!"})

@app.route('/delete_book', methods=['POST'])
@admin_required
def delete_book():
    data = request.get_json()
    id_ = data.get('id')
    conn = sqlite3.connect('library.db')
    cur = conn.cursor()
    cur.execute("DELETE FROM books WHERE id=?", (id_,))
    conn.commit()
    conn.close()
    return jsonify({"message": "Book deleted!"})

@app.route('/add_member', methods=['POST'])
@admin_required
def add_member():
    data = request.get_json()
    name = data.get('name', '').strip()
    email = data.get('email', '').strip()
    phone = data.get('phone', '').strip()

    if not name or not name.replace(" ", "").isalpha():
        return jsonify({"message": "Invalid name format"}), 400
    if '@' not in email or email.endswith('@'):
        return jsonify({"message": "Invalid email format"}), 400
    if not phone.isdigit():
        return jsonify({"message": "Invalid phone number"}), 400

    try:
        conn = sqlite3.connect('library.db')
        cur = conn.cursor()
        cur.execute("INSERT INTO members (name, email, phone) VALUES (?, ?, ?)", (name, email.lower(), phone))
        conn.commit()
        conn.close()
        return jsonify({"message": "Member added!", "success": True})
    except Exception as e:
        print(f"Error adding member: {e}")
        return jsonify({"message": "Failed to add member", "success": False}), 500

